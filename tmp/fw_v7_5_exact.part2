}

void handleLogDownload() {
  String filename =
    "ESP_Print_Server_" +
    macSuffix +
    "_log.txt";

  web.sendHeader(
    "Content-Disposition",
    "attachment; filename=\"" +
    filename +
    "\""
  );

  web.sendHeader(
    "Cache-Control",
    "no-store"
  );

  String h;

  h += "Lumitool Printsever V7.5\n";
  h += "AP: " + apSsid + "\n";
  h += "Local: " + localUrl + "\n";
  h += "Printer A: TCP 9101\n";
  h += "Printer B: TCP 9102\n";
  h += "Printer C: TCP 9103\n";
  h += "PSRAM: ";
  h += psramFound()
         ? "YES\n"
         : "NO\n";
  h += "Queue allocated: ";
  h += formatBytes(
    totalQueueAllocated
  );
  h += "\nGlobal error: ";
  h += globalLastError;
  h += "\n----------------------------------------\n";

  web.send(
    200,
    "text/plain; charset=utf-8",
    h + systemLog
  );
}

void handleLogClear() {
  systemLog = "";
  addLog("Log cleared");

  web.sendHeader(
    "Location",
    "/log",
    true
  );

  web.send(
    303,
    "text/plain",
    ""
  );
}

void handleForget() {
  addLog("Forget Wi-Fi requested");

  forgetWifiSettings();
  mdnsStarted = false;

  web.send(
    200,
    "text/html; charset=utf-8",
    "<html><body style='font-family:Arial;padding:24px'>"
    "<h2>Đã quên Wi-Fi</h2>"
    "<p>Kết nối lại Lumitool Printsever và mở 192.168.10.1.</p>"
    "</body></html>"
  );
}

void handleRestart() {
  addLog("Restart requested");

  web.send(
    200,
    "text/plain",
    "Restarting..."
  );

  delay(350);
  ESP.restart();
}

void captiveRedirect() {
  web.sendHeader(
    "Location",
    "http://192.168.10.1/",
    true
  );

  web.send(
    302,
    "text/plain",
    ""
  );
}



String makeDeviceInfoJson() {
  String j = "{";

  j += "\"magic\":\"";
  j += PRODUCT_MAGIC;
  j += "\"";

  j += ",\"brand\":\"Lumitool\"";
  j += ",\"product\":\"Lumitool Printsever\"";
  j += ",\"version\":\"V7.5\"";

  j += ",\"id\":\"";
  j += macSuffix;
  j += "\"";

  j += ",\"device_name\":\"";
  j += jsonEscape(hostName);
  j += "\"";

  j += ",\"mac\":\"";
  j += stationMacText;
  j += "\"";

  j += ",\"hostname\":\"";
  j += hostName;
  j += ".local\"";

  j += ",\"ip\":\"";

  if (
    WiFi.status() ==
    WL_CONNECTED
  ) {
    j +=
      WiFi.localIP().
      toString();
  } else {
    j +=
      WiFi.softAPIP().
      toString();
  }

  j += "\"";

  j += ",\"ap_ip\":\"";
  j +=
    WiFi.softAPIP().
    toString();
  j += "\"";

  j +=
    ",\"ports\":{"
    "\"A\":9101,"
    "\"B\":9102,"
    "\"C\":9103"
    "}";

  j +=
    ",\"wifi_connected\":";

  j +=
    WiFi.status() ==
    WL_CONNECTED
      ? "true"
      : "false";

  j +=
    ",\"printers\":{";

  j += "\"A\":\"";
  j +=
    jsonEscape(
      printerHealthText(
        printers[0]
      )
    );

  j += "\",\"B\":\"";
  j +=
    jsonEscape(
      printerHealthText(
        printers[1]
      )
    );

  j += "\",\"C\":\"";
  j +=
    jsonEscape(
      printerHealthText(
        printers[2]
      )
    );

  j += "\"}";

  j += "}";

  return j;
}

void handleDeviceInfo() {
  web.sendHeader(
    "Cache-Control",
    "no-store"
  );

  web.send(
    200,
    "application/json; charset=utf-8",
    makeDeviceInfoJson()
  );
}

void startDiscovery() {
  if (
    discoveryStarted
  ) {
    return;
  }

  if (
    discoveryUdp.begin(
      DISCOVERY_PORT
    )
  ) {

    discoveryStarted =
      true;

    addLog(
      "Lumitool discovery UDP started: " +
      String(DISCOVERY_PORT)
    );

  } else {

    addLog(
      "Lumitool discovery UDP start failed"
    );
  }
}

void processDiscovery() {
  if (
    !discoveryStarted
  ) {
    startDiscovery();
    return;
  }

  int packetSize =
    discoveryUdp.parsePacket();

  if (
    packetSize <= 0
  ) {
    return;
  }

  char buf[96];

  int n =
    discoveryUdp.read(
      buf,
      sizeof(buf) - 1
    );

  if (
    n <= 0
  ) {
    return;
  }

  buf[n] = 0;

  String msg =
    String(buf);

  msg.trim();

  if (
    msg !=
    DISCOVERY_MAGIC
  ) {
    return;
  }

  IPAddress requesterIp =
    discoveryUdp.remoteIP();

  uint16_t requesterPort =
    discoveryUdp.remotePort();

  String payload =
    makeDeviceInfoJson();

  discoveryUdp.beginPacket(
    requesterIp,
    requesterPort
  );

  discoveryUdp.write(
    (const uint8_t *)
      payload.c_str(),
    payload.length()
  );

  discoveryUdp.endPacket();

  addLog(
    "Discovery reply -> " +
    requesterIp.toString()
  );
}

String makeSupportPage() {
  String p;
  p.reserve(9000);

  p += F(
    "<!doctype html><html><head>"
    "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<meta charset='utf-8'><title>Support / OTA</title>"
    "<style>"
    "*{box-sizing:border-box}"
    "body{font-family:Arial;background:#f3f5f7;margin:0;color:#171717}"
    ".w{max-width:760px;margin:auto;padding:14px}"
    ".c{background:#fff;border-radius:12px;padding:14px;margin:10px 0;box-shadow:0 1px 8px #0001}"
    "h1{font-size:21px;margin:2px 0 10px}"
    "h2{font-size:16px;margin:0 0 9px}"
    ".g{display:grid;grid-template-columns:1fr 1fr;gap:7px}"
    ".kv{padding:9px;background:#f6f7f9;border-radius:8px;font-size:12px;word-break:break-word}"
    "button,.btn{display:block;width:100%;padding:10px;border:0;border-radius:8px;background:#111;color:#fff;font-weight:700;text-decoration:none;text-align:center;margin:6px 0;cursor:pointer}"
    ".ghost{background:#fff;color:#111;border:1px solid #ddd}"
    "input[type=file]{width:100%;padding:9px;border:1px solid #ddd;border-radius:8px;background:#fff}"
    ".bar{height:18px;background:#e9ecef;border-radius:9px;overflow:hidden}"
    ".fill{height:100%;width:0;background:#111;transition:width .1s}"
    ".small{font-size:12px;color:#666;line-height:1.45}"
    "@media(max-width:620px){.g{grid-template-columns:1fr}}"
    "</style></head><body><div class='w'>"
  );

  p += "<h1>Hỗ trợ / Nạp firmware · ";
  p += macSuffix;
  p += "</h1>";

  p += "<div class='c'><h2>Thiết bị</h2><div class='g'>";

  p += "<div class='kv'>Firmware<br><b>V7.5</b></div>";

  p += "<div class='kv'>Reset reason<br><b>";
  p += resetReasonText(
    esp_reset_reason()
  );
  p += "</b></div>";

  p += "<div class='kv'>OTA đang chạy<br><b>";
  p += currentOtaPartitionLabel();
  p += "</b></div>";

  p += "<div class='kv'>OTA kế tiếp<br><b>";
  p += htmlEscape(
    nextOtaPartitionInfo()
  );
  p += "</b>